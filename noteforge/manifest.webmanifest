{
  "name": "NoteForge",
  "short_name": "NoteForge",
  "description": "A local-first markdown notes app with wikilinks, backlinks, tags, and a graph.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "share_target": {
    "action": "./?source=share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "background_color": "#16181d",
  "theme_color": "#3b6ef6",
  "icons": [
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ]
}
