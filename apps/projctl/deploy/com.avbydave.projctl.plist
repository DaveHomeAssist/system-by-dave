<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.avbydave.projctl</string>
  <key>ProgramArguments</key><array><string>__NODE__</string><string>__APP__/server/index.js</string></array>
  <key>WorkingDirectory</key><string>__APP__</string>
  <key>EnvironmentVariables</key><dict>
    <key>PORT</key><string>8080</string>
    <key>PJ_PASSCODE</key><string>__PASSCODE__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>__APP__/data/projctl.log</string>
  <key>StandardErrorPath</key><string>__APP__/data/projctl.log</string>
</dict>
</plist>
