{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systembydave.com/schemas/run-event.schema.json",
  "title": "Portfolio structured run event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timestamp", "severity", "product", "environment", "event_type", "status", "run_id", "correlation_id", "commit_sha", "message"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "timestamp": { "type": "string", "format": "date-time" },
    "severity": { "type": "string", "enum": ["debug", "info", "warn", "error", "critical"] },
    "product": { "type": "string", "enum": ["frontier-signals", "frontier-data-lab", "hat-in-ring", "curlplan", "phillies-wire"] },
    "environment": { "type": "string", "enum": ["local", "ci", "staging", "production"] },
    "event_type": { "type": "string", "enum": ["run_started", "source_collected", "record_normalized", "review_required", "verification_completed", "artifact_built", "deployment_completed", "run_completed", "run_failed"] },
    "status": { "type": "string", "enum": ["started", "succeeded", "failed", "blocked", "degraded"] },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "workflow": { "type": "string", "maxLength": 160 },
    "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
    "evidence_urls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
