export type Field = 'unit' | 'fixture' | 'position' | 'mode' | 'universe' | 'address' | 'channel' | 'dimmer' | 'color' | 'focus' | 'status' | 'notes';
export type Fixture = Record<Field, string> & { id: string; sourceId?: string };
export type LightingPlan = { schema: string; meta: { showName: string; venue: string; lead: string }; items: Fixture[]; plotforgeSource?: Record<string, unknown> };
export const KEY: string;
export const SCHEMA: string;
export const LEGACY: string;
export const PLOTFORGE_KIND: string;
export const MAX_IMPORT_BYTES: number;
export const MAX_MANIFEST_CHARS: number;
export const FIELDS: Field[];
export const STATUSES: string[];
export function blank(): LightingPlan;
export function fixture(raw: unknown): Fixture;
export function validate(raw: unknown): LightingPlan;
export function plotForgeManifest(raw: unknown): Record<string, unknown>;
export function fromPlotForge(raw: unknown): { plan: LightingPlan; needsWork: number; unknownStatuses: number };
export function conflicts(plan: LightingPlan): Map<string, number>;
export function addressKey(item: Fixture): string;
export function hasConflict(item: Fixture, map: Map<string, number>): boolean;
