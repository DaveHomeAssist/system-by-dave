export const KEY: string;
export const ADVANCE_KEY: string;
export const ADVANCE_SCHEMA: string;
export const STAGES: readonly string[];
export type Client = { id: string; name: string; contact: string; notes: string };
export type Venue = { id: string; name: string; location: string; notes: string };
export type Job = { id: string; name: string; clientId: string; venueId: string; stage: string; nextAction: string; updates: { id: string; body: string; date: string }[]; sourceAdvance?: { schema: string; importedAt: string; raw: string } };
export type OfficeDocument = { version: 1; clients: Client[]; venues: Venue[]; jobs: Job[]; [key: string]: unknown };
export type Advance = { raw: string; meta: Record<string,string>; items: Record<string,string>[]; signature: string; statusCounts: Record<string,number>; unsupportedStatuses: string[] };
export type Binding = { clientId: string; venueId: string; clientName?: string; venueName?: string; jobName: string };
export function emptyDocument(): OfficeDocument;
export function parseDocument(raw: string): OfficeDocument;
export function validateDocument(value: unknown): OfficeDocument;
export function addClient(doc: OfficeDocument, name: string, contact: string, notes: string): OfficeDocument;
export function addVenue(doc: OfficeDocument, name: string, location: string, notes: string): OfficeDocument;
export function addJob(doc: OfficeDocument, name: string, clientId: string, venueId: string, nextAction: string): OfficeDocument;
export function updateJob(doc: OfficeDocument, id: string, stage: string, nextAction: string, note: string, date: string): OfficeDocument;
export function parseShowAdvance(raw: string): Advance;
export function alreadyImportedAdvance(doc: OfficeDocument, source: Advance): boolean;
export function appendShowAdvance(doc: OfficeDocument, source: Advance, binding: Binding, importedAt?: string): OfficeDocument;
