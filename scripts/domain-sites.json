{
  "schema": "system-by-dave.domain-sites.v1",
  "origin": "https://systembydave.com",
  "sourceRepository": "DaveHomeAssist/system-by-dave",
  "sites": [
    {
      "id": "housevideo",
      "name": "FMP Video Operations",
      "domain": "housevideo.app",
      "repository": "DaveHomeAssist/housevideo",
      "deployKeySecret": "HOUSEVIDEO_DEPLOY_KEY",
      "cutover": true,
      "home": "/fmp/",
      "pages": ["fmp/", "fmpwalk/", "fmp-index/", "fmp-walk/", "switcher/", "shader/", "ursa-broadcast-g2/", "backfocus/"],
      "assets": [],
      "robotsDisallow": ["/404.html", "/transfer.html", "/fmp-index/", "/fmp/", "/fmp-walk/", "/fmpwalk/"],
      "storage": {
        "registryKeys": false,
        "keys": [],
        "prefixes": ["fmp"],
        "indexedDB": ["fmpPhotosV1"]
      }
    },
    {
      "id": "avbydave",
      "name": "AV by Dave",
      "domain": "avbydave.com",
      "repository": "DaveHomeAssist/avbydave",
      "deployKeySecret": "AVBYDAVE_DEPLOY_KEY",
      "cutover": true,
      "home": "/av-suite.html",
      "registry": true,
      "pages": ["av-suite.html", "av-workbook.html", "av-tool-suite/"],
      "assets": [],
      "robotsDisallow": ["/404.html", "/transfer.html"],
      "storage": {
        "registryKeys": true,
        "keys": ["av-suite-dashboard.v1", "av-suite-ui.v1", "av-suite-dock-compact.v1", "av-theme-mode.v1", "sbd.handoff.v1"],
        "prefixes": ["sbd.handoff.", "sbd.showboard."],
        "indexedDB": ["PixelForge"]
      }
    }
  ]
}
